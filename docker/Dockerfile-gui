FROM httpd:2.4 AS build 

ARG version

RUN apt update
RUN apt install -y unzip

COPY docker/httpd.conf /usr/local/apache2/conf/httpd.conf

USER root
COPY ./zonemaster_web_gui_${version}.zip /tmp

WORKDIR /tmp
RUN unzip zonemaster_web_gui_${version}.zip
RUN mv dist/* /usr/local/apache2/htdocs/

FROM httpd:2.4

EXPOSE 80

COPY --from=build /usr/local/apache2/ /usr/local/apache2
